{
  "name": "futari-de-tennis",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  // デプロイ / dev の前に自動でフロントエンドをビルドして dist を作る
  // (Cloudflare 側のビルドコマンド欄が空でも動くようにするため)
  "build": { "command": "npm run build" },

  // vite build で作られた dist を配信。
  // run_worker_first: /ws (WebSocket) を Worker に必ず通すため
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // 部屋ごとの状態を持つ Durable Object (無料プランは sqlite クラスが必須)
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
